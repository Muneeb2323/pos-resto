<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="IE=edge">
<title>FORK &amp; FIRE - POS Controller</title>
<hta:application 
    id="oForkAndFire"
    applicationname="ForkAndFirePOS"
    icon="public\logo.ico"
    border="dialog"
    borderstyle="normal"
    caption="yes"
    maximizebutton="no"
    minimizebutton="yes"
    navigable="no"
    scroll="no"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
/>
<link rel="icon" type="image/png" href="public/logo.PNG">
<link rel="shortcut icon" href="public/logo.ico">
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        user-select: none;
        outline: none;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    html, body {
        width: 100%;
        height: 100%;
        background: #0d0f17;
        background: radial-gradient(circle at 50% 0%, #1a1d2e 0%, #0d0f17 80%);
        color: #f3f4f6;
        overflow: hidden;
    }
    .header {
        background: #141724;
        background: linear-gradient(180deg, #181c2c 0%, #121522 100%);
        padding: 16px 22px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .brand-logo-wrap {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: #141724;
        border: 1px solid rgba(249, 115, 22, 0.35);
        box-shadow: 0 2px 10px rgba(249, 115, 22, 0.25);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .brand-logo-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .brand-title {
        font-size: 19px;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: #f97316;
        text-transform: uppercase;
    }
    .brand-sub {
        font-size: 11px;
        color: #94a3b8;
        letter-spacing: 0.4px;
        margin-top: 1px;
    }
    .content {
        padding: 18px 22px 14px 22px;
    }
    .status-bar {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 8px;
        padding: 9px 14px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .dot-amber {
        background: #f59e0b;
        box-shadow: 0 0 8px #f59e0b;
    }
    .dot-green {
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
    }
    .dot-red {
        background: #ef4444;
        box-shadow: 0 0 8px #ef4444;
    }
    .status-text {
        font-size: 12px;
        color: #cbd5e1;
        font-weight: 500;
        letter-spacing: 0.2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .btn {
        display: block;
        width: 100%;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 700;
        text-align: center;
        transition: all 0.15s ease-in-out;
    }
    .btn-primary {
        background: #ea580c;
        background: linear-gradient(135deg, #fb923c 0%, #ea580c 100%);
        color: #ffffff;
        font-size: 14px;
        letter-spacing: 0.8px;
        padding: 15px;
        margin-bottom: 12px;
        box-shadow: 0 4px 16px rgba(234, 88, 12, 0.4);
    }
    .btn-primary:hover {
        background: linear-gradient(135deg, #fdba74 0%, #f97316 100%);
        box-shadow: 0 6px 20px rgba(234, 88, 12, 0.6);
        transform: translateY(-1px);
    }
    .btn-primary:active {
        transform: translateY(1px);
    }
    .btn-row {
        display: flex;
        gap: 12px;
        margin-bottom: 12px;
        width: 100%;
    }
    .btn-half {
        flex: 1;
        width: 48%;
        padding: 12px;
        font-size: 12.5px;
        letter-spacing: 0.5px;
        color: #ffffff;
    }
    .btn-blue {
        background: #2563eb;
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }
    .btn-blue:hover {
        background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.45);
        transform: translateY(-1px);
    }
    .btn-red {
        background: #dc2626;
        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
    }
    .btn-red:hover {
        background: linear-gradient(135deg, #f87171 0%, #dc2626 100%);
        box-shadow: 0 6px 16px rgba(220, 38, 38, 0.45);
        transform: translateY(-1px);
    }
    .btn-quit {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #94a3b8;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.4px;
        padding: 10px;
        border-radius: 8px;
    }
    .btn-quit:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        color: #ffffff;
    }
    .footer {
        text-align: center;
        font-size: 11px;
        color: #64748b;
        margin-top: 14px;
        letter-spacing: 0.3px;
    }
</style>
<script>
    window.onload = function() {
        var w = 450;
        var h = 370;
        window.resizeTo(w, h);
        var x = (screen.availWidth - w) / 2;
        var y = (screen.availHeight - h) / 2;
        window.moveTo(x, y);
    };

    function setStatus(text, dotClass) {
        document.getElementById("statusMsg").innerText = text;
        document.getElementById("statusDot").className = "dot " + dotClass;
    }

    function startPos() {
        try {
            var shell = new ActiveXObject("WScript.Shell");
            setStatus("Starting Fork & Fire POS servers...", "dot-amber");
            shell.Run("cmd /c START_FORK_AND_FIRE.bat 1", 0, false);
            setTimeout(finishStart, 4000);
        } catch(e) {
            alert("Error starting servers: " + e.message);
        }
    }

    function finishStart() {
        setStatus("POS running on http://localhost:3000 (Click to open)", "dot-green");
    }

    function openWeb() {
        try {
            var shell = new ActiveXObject("WScript.Shell");
            shell.Run("http://localhost:3000");
        } catch(e) {}
    }

    function restartPos() {
        try {
            var shell = new ActiveXObject("WScript.Shell");
            setStatus("Restarting servers, please wait...", "dot-amber");
            shell.Run("cmd /c STOP_FORK_AND_FIRE.bat", 0, true);
            shell.Run("cmd /c START_FORK_AND_FIRE.bat 1", 0, false);
            setTimeout(finishStart, 4500);
        } catch(e) {
            alert("Error restarting: " + e.message);
        }
    }

    function stopPos() {
        try {
            var shell = new ActiveXObject("WScript.Shell");
            setStatus("Stopping all servers...", "dot-red");
            shell.Run("cmd /c STOP_FORK_AND_FIRE.bat", 0, true);
            setStatus("All servers stopped.", "dot-red");
        } catch(e) {
            alert("Error stopping: " + e.message);
        }
    }

    function quitApp() {
        try {
            var shell = new ActiveXObject("WScript.Shell");
            var res = shell.Popup("Do you want to stop background servers before exiting?", 0, "Fork & Fire POS", 3 + 32);
            // 6 = Yes, 7 = No, 2 = Cancel
            if (res === 2) return;
            if (res === 6) {
                shell.Run("cmd /c STOP_FORK_AND_FIRE.bat", 0, true);
            }
            window.close();
        } catch(e) {
            window.close();
        }
    }
</script>
</head>
<body>

    <div class="header">
        <div class="brand-logo-wrap">
            <img src="public/logo.PNG" alt="Fork & Fire Logo" class="brand-logo-img" />
        </div>
        <div>
            <div class="brand-title">FORK &amp; FIRE</div>
            <div class="brand-sub">Restaurant POS System Controller • Fast Food &amp; Pizza</div>
        </div>
    </div>

    <div class="content">
        <div class="status-bar" onclick="openWeb()" title="Click to open POS in browser" style="cursor: pointer;">
            <span id="statusDot" class="dot dot-amber"></span>
            <span id="statusMsg" class="status-text">Ready. Click START to launch system.</span>
        </div>

        <button class="btn btn-primary" onclick="startPos()">▶ &nbsp; START &amp; OPEN POS WEB</button>

        <div class="btn-row">
            <button class="btn btn-half btn-blue" onclick="restartPos()">↻ &nbsp; RESTART</button>
            <button class="btn btn-half btn-red" onclick="stopPos()">⏹ &nbsp; STOP SERVERS</button>
        </div>

        <button class="btn btn-quit" onclick="quitApp()">✕ &nbsp; QUIT CONTROLLER</button>

        <div class="footer">Fork &amp; Fire POS • Offline Fast Food Terminal • v1.0</div>
    </div>

</body>
</html>
